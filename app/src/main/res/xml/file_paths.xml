<?xml version="1.0" encoding="utf-8"?>

<paths>
    <!-- Photos captured with the camera are written here as temporary files
         and deleted once they have been read and uploaded. -->
    <cache-path
        name="photos"
        path="photos/" />

    <!-- The beta build's self-updater downloads its APK here and hands it to the
         system package installer through this provider. -->
    <cache-path
        name="updates"
        path="updates/" />
</paths>
