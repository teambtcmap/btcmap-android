<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:menu="@menu/place"
        tools:text="Satoshi's Bar" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <Button
                    android:id="@+id/btnVerify"
                    style="@style/Button.Outlined.NoTopInset"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:text="@string/btn_verify"
                    app:icon="@drawable/icon_verified"
                    app:iconGravity="textStart"
                    app:iconTint="@color/verify_green" />

                <Button
                    android:id="@+id/btnReport"
                    style="@style/Button.Outlined.NoTopInset"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="16dp"
                    android:layout_weight="1"
                    android:text="@string/btn_report"
                    app:icon="@drawable/icon_warning"
                    app:iconGravity="textStart"
                    app:iconTint="@color/report_red" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <Button
                    android:id="@+id/boost"
                    style="@style/Button.Outlined.NoTopInset"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:insetBottom="0dp"
                    android:minHeight="36dp"
                    android:layout_gravity="center"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:text="@string/boost"
                    app:icon="@drawable/icon_rocket_launch"
                    app:iconGravity="textStart" />

                <Button
                    android:id="@+id/comments"
                    style="@style/Button.Outlined.NoTopInset"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:insetBottom="0dp"
                    android:minHeight="36dp"
                    android:layout_gravity="center"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="16dp"
                    android:layout_weight="1"
                    android:text="@string/comments"
                    app:icon="@drawable/icon_comment"
                    app:iconGravity="textStart" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/lastVerified"
                    style="?attr/textAppearanceSubtitle1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawablePadding="20dp"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="16dp"
                    app:drawableStartCompat="@drawable/icon_verified"
                    app:drawableTint="?colorSecondary"
                    tools:text="Last verified on Oct 14, 2022" />

                <TextView
                    android:id="@+id/outdated"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:layout_weight="1"
                    android:text="warning"
                    android:textColor="?colorError"
                    android:textSize="20dp"
                    tools:ignore="HardcodedText,SpUsage" />

            </LinearLayout>

            <TextView
                android:id="@+id/companionWarning"
                style="?attr/textAppearanceSubtitle1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autoLink="web"
                android:drawablePadding="20dp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="16dp"
                app:drawableStartCompat="@drawable/icon_warning"
                app:drawableTint="?colorError" />

            <TextView
                android:id="@+id/address"
                style="?attr/textAppearanceSubtitle1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawablePadding="20dp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="16dp"
                app:drawableStartCompat="@drawable/icon_place"
                app:drawableTint="?colorSecondary" />

            <TextView
                android:id="@+id/phone"
                style="?attr/textAppearanceSubtitle1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autoLink="phone"
                android:drawablePadding="20dp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="16dp"
                android:singleLine="true"
                app:drawableStartCompat="@drawable/icon_call"
                app:drawableTint="?colorSecondary" />

            <TextView
                android:id="@+id/website"
                style="?attr/textAppearanceSubtitle1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autoLink="web"
                android:drawablePadding="20dp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="16dp"
                android:singleLine="true"
                app:drawableStartCompat="@drawable/icon_earth"
                app:drawableTint="?colorSecondary" />

            <TextView
                android:id="@+id/telegram"
                style="?attr/textAppearanceSubtitle1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawablePadding="20dp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="16dp"
                android:singleLine="true"
                app:drawableStartCompat="@drawable/icon_telegram"
                app:drawableTint="?colorSecondary"
                tools:text="https://telegram.org/" />

            <TextView
                android:id="@+id/line"
                style="?attr/textAppearanceSubtitle1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawablePadding="20dp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="16dp"
                android:singleLine="true"
                app:drawableStartCompat="@drawable/icon_line"
                app:drawableTint="?colorSecondary"
                tools:text="https://www.line.me/" />

            <TextView
                android:id="@+id/twitter"
                style="?attr/textAppearanceSubtitle1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawablePadding="20dp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="16dp"
                android:singleLine="true"
                app:drawableStartCompat="@drawable/icon_twitter"
                app:drawableTint="?colorSecondary"
                tools:text="BTCMapDotOrg" />

            <TextView
                android:id="@+id/facebook"
                style="?attr/textAppearanceSubtitle1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawablePadding="20dp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="16dp"
                android:singleLine="true"
                app:drawableStartCompat="@drawable/icon_facebook"
                app:drawableTint="?colorSecondary"
                tools:text="https://www.facebook.com" />

            <TextView
                android:id="@+id/instagram"
                style="?attr/textAppearanceSubtitle1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawablePadding="20dp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="16dp"
                android:singleLine="true"
                app:drawableStartCompat="@drawable/icon_instagram"
                app:drawableTint="?colorSecondary"
                tools:text="BTCMapDotOrg" />

            <TextView
                android:id="@+id/email"
                style="?attr/textAppearanceSubtitle1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autoLink="email"
                android:drawablePadding="20dp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="16dp"
                android:singleLine="true"
                app:drawableStartCompat="@drawable/icon_email"
                app:drawableTint="?colorSecondary"
                tools:text="BTCMapDotOrg" />

            <TextView
                android:id="@+id/openingHours"
                style="?attr/textAppearanceSubtitle1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawablePadding="20dp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="16dp"
                app:drawableStartCompat="@drawable/icon_schedule"
                app:drawableTint="?colorSecondary" />

            <TextView
                android:id="@+id/comments_title"
                style="?attr/textAppearanceSubtitle1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawablePadding="20dp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="16dp"
                android:singleLine="true"
                android:text="@string/comments_d"
                app:drawableStartCompat="@drawable/icon_comment"
                app:drawableTint="?colorSecondary" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/comments_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/add_comment"
                style="@style/Button.Outlined.NoTopInset"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:text="@string/comment"
                app:icon="@drawable/icon_comment"
                app:iconGravity="textStart" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="60dp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>