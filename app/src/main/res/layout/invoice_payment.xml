<?xml version="1.0" encoding="utf-8"?>

<!--
  The Lightning invoice block shared by the boost and comment payment screens:
  the QR code, the pay and copy actions and the start-over escape hatch. The
  controller hides the whole block until an invoice exists, and each action is
  hidden until it is wired, so the layout stays inert on its own.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/qr"
        android:layout_width="match_parent"
        android:layout_height="230dp"
        android:layout_marginHorizontal="40dp"
        android:contentDescription="@string/qr_code"
        android:visibility="gone"
        tools:background="#ff0000"
        tools:visibility="visible" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="40dp"
        android:layout_marginVertical="16dp"
        android:gravity="center">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/pay_invoice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="@string/pay"
            android:visibility="gone"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/copy_invoice"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@android:string/copy"
            android:visibility="gone"
            tools:visibility="visible" />

    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/start_over"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:text="@string/start_over"
        android:visibility="gone"
        tools:visibility="visible" />

</LinearLayout>
