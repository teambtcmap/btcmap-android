#!/usr/bin/env bash

set -euo pipefail

print_usage() {
  cat <<EOF
devtools — manage the BTC Map Android dev environment.

Usage:
  ./devtools emulator start     Boot the AVD asynchronously
  ./devtools emulator stop      Shut the emulator down cleanly
  ./devtools app install        Install debug build
  ./devtools app run            Run the app (desktop by default; --android for the emulator)
  ./devtools app stop           Stop the running app (desktop by default)
  ./devtools app uninstall      Uninstall the app
  ./devtools app deploy-beta    Build and deploy beta APK, desktop packages and manifest
  ./devtools app deploy-release Build and deploy release APK and desktop packages
  ./devtools bundle data        Download latest places, areas, comments and events snapshots
  ./devtools bundle map-styles  Bundle MapLibre styles, sprites and glyphs (--force re-downloads)
  ./devtools bundle icons       Extract the icon-name list from the bundled font
  ./devtools bundle all         Run all bundlers (--force applies to map-styles)
  ./devtools website deploy     Build the Hugo site and rsync it to android.btcmap.org
EOF
}

err() {
  echo "Error: $*" >&2
}

print_usage_emulator() {
  cat <<EOF
Usage: ./devtools emulator <command>

Commands:
  start    Boot the AVD asynchronously
  stop     Shut the emulator down cleanly
EOF
}

print_usage_app() {
  cat <<EOF
Usage: ./devtools app <command>

Commands:
  install        Install debug build
  run            Run the app. Runs the desktop app by default, or the Android
                 build on the emulator with --android.
  stop           Stop the running app (desktop by default; --android for the emulator)
  uninstall      Uninstall the app
  deploy-beta    Build and deploy the beta APK, the Windows/macOS packages, the
                 Linux AppImage and the beta manifest
  deploy-release Build and deploy the release APK and the Windows/macOS/Linux
                 desktop packages
EOF
}

print_usage_bundle() {
  cat <<EOF
Usage: ./devtools bundle <command>

Commands:
  data         Download latest places, areas, comments and events snapshots (always refreshes)
  map-styles   Bundle MapLibre styles, sprites and glyphs (--force re-downloads)
  icons        Extract the icon-name list from the bundled Material Symbols font
  all          Run all bundlers (--force applies to map-styles)
EOF
}

print_usage_website() {
  cat <<EOF
Usage: ./devtools website <command>

Commands:
  deploy    Build the Hugo site and rsync it to btcmap-api:/srv/http/android.btcmap.org
EOF
}

# START emulator section

cmd_emulator_start() {
  # Detach from the shell so the script can exit cleanly while the
  # emulator keeps running.
  nohup setsid emulator -avd Resizable_Experimental -gpu host > emulator.log 2>&1 < /dev/null & disown
}

cmd_emulator_stop() {
  adb devices | grep emulator | cut -f1 | while read line; do adb -s $line emu kill; done
  rm emulator.log
}

cmd_emulator() {
  local sub="${1:-help}"
  shift || true
  case "$sub" in
    start)     cmd_emulator_start ;;
    stop)      cmd_emulator_stop ;;
    help|-h|--help) print_usage_emulator ;;
    *) err "Unknown emulator command: $sub"; print_usage_emulator; return 1 ;;
  esac
}

# END emulator section

# START signing section

android_sdk_dir() {
  if [ -n "${ANDROID_HOME:-}" ]; then
    echo "$ANDROID_HOME"
    return 0
  fi
  if [ -n "${ANDROID_SDK_ROOT:-}" ]; then
    echo "$ANDROID_SDK_ROOT"
    return 0
  fi
  local sdk_dir
  sdk_dir="$(sed -n 's/^sdk\.dir=//p' local.properties 2>/dev/null | head -n1)"
  if [ -n "$sdk_dir" ]; then
    echo "$sdk_dir"
    return 0
  fi
  return 1
}

find_apksigner() {
  local sdk_dir
  sdk_dir="$(android_sdk_dir)" || return 1
  local build_tools
  build_tools="$(ls -d "$sdk_dir"/build-tools/*/ 2>/dev/null | sort -V | tail -n1)"
  [ -n "$build_tools" ] && [ -x "${build_tools}apksigner" ] && echo "${build_tools}apksigner"
}

assert_apk_signed() {
  local apk="$1"
  if [ ! -f "$apk" ]; then
    echo "Error: APK not found at $apk" >&2
    return 1
  fi
  local apksigner
  if ! apksigner="$(find_apksigner)"; then
    echo "Error: could not locate apksigner; refusing to deploy an unsigned APK." >&2
    return 1
  fi
  if ! "$apksigner" verify --print-certs "$apk" >/dev/null 2>&1; then
    echo "Error: $apk is not signed. Add the release keystore properties to local.properties." >&2
    return 1
  fi
  echo "$apk is signed."
}

# END signing section

# START bundle section

cmd_bundle_data() {
  python3 bundle_places.py "$@"
  python3 bundle_areas.py "$@"
  python3 bundle_comments.py "$@"
  python3 bundle_events.py "$@"
}

cmd_bundle_map_styles() {
  python3 bundle_map_styles.py "$@"
}

cmd_bundle_icons() {
  python3 bundle_icons.py "$@"
}

cmd_bundle() {
  local target="${1:-help}"
  shift || true
  case "$target" in
    data) cmd_bundle_data "$@" ;;
    map-styles) cmd_bundle_map_styles "$@" ;;
    icons) cmd_bundle_icons "$@" ;;
    all) cmd_bundle_data "$@"; cmd_bundle_map_styles "$@"; cmd_bundle_icons "$@" ;;
    help|-h|--help) print_usage_bundle ;;
    *) err "Unknown bundle command: $target"; print_usage_bundle; return 1 ;;
  esac
}

# END bundle section

# START website section

cmd_website_deploy() {
  if ! command -v hugo >/dev/null 2>&1; then
    err "hugo is not installed; install Hugo to build the site."
    return 1
  fi

  local dest="btcmap-api:/srv/http/android.btcmap.org/"

  # Hugo does not prune its output, so clear it to avoid shipping stale pages
  # from earlier builds.
  echo "Building the Hugo site..."
  rm -rf website/public
  (cd website && hugo)

  echo "Deploying to $dest..."
  rsync -avz --delete --chmod=D755,F644 website/public/ "$dest"
}

cmd_website() {
  local target="${1:-help}"
  shift || true
  case "$target" in
    deploy) cmd_website_deploy "$@" ;;
    help|-h|--help) print_usage_website ;;
    *) err "Unknown website command: $target"; print_usage_website; return 1 ;;
  esac
}

# END website section

# START cdn section

# BunnyCDN API key for the static.btcmap.org pull zone. Set BUNNY_API_KEY in
# the environment or add `bunny.api.key=...` to local.properties.
bunny_api_key() {
  if [ -n "${BUNNY_API_KEY:-}" ]; then
    printf '%s' "$BUNNY_API_KEY"
    return 0
  fi
  local key
  key="$(sed -n 's/^bunny\.api\.key=//p' local.properties 2>/dev/null | head -n1)"
  if [ -n "$key" ]; then
    printf '%s' "$key"
    return 0
  fi
  return 1
}

assert_bunny_api_key() {
  if ! bunny_api_key >/dev/null; then
    err "no BunnyCDN API key; refusing to deploy without purging the CDN cache."
    err "Set BUNNY_API_KEY in the environment or add 'bunny.api.key=...' to local.properties."
    return 1
  fi
}

# Purge absolute CDN URLs from the Bunny edge cache, waiting for the purge to
# complete so a request right after the deploy cannot hit a stale object.
purge_cdn() {
  local key
  key="$(bunny_api_key)" || return 1
  local url
  for url in "$@"; do
    echo "Purging $url from the CDN..."
    curl -fsS -X POST -G \
      --data-urlencode "url=$url" \
      --data-urlencode "async=false" \
      -H "AccessKey: $key" \
      "https://api.bunny.net/purge" >/dev/null
  done
}

# END cdn section

# START appimage section

# appimagetool only publishes a moving "continuous" build, so the URL can be
# overridden to pin one. A ready-made binary can also be pointed at directly
# with APPIMAGETOOL=/path/to/appimagetool.
appimagetool_url_default="https://github.com/AppImage/appimagetool/releases/download/continuous/appimagetool-x86_64.AppImage"

# Downloads and extracts appimagetool into a cache on first use, then prints the
# path to a runnable appimagetool. The extracted form is used so packing does
# not need a FUSE mount of the tool itself.
prepare_appimagetool() {
  if [ -n "${APPIMAGETOOL:-}" ]; then
    printf '%s' "$APPIMAGETOOL"
    return 0
  fi

  local dir="${XDG_CACHE_HOME:-$HOME/.cache}/btcmap/appimagetool"
  local apprun="$dir/squashfs-root/AppRun"
  if [ -x "$apprun" ]; then
    printf '%s' "$apprun"
    return 0
  fi

  local url="${APPIMAGETOOL_URL:-$appimagetool_url_default}"
  echo "Downloading appimagetool from $url..." >&2
  mkdir -p "$dir"
  local image="$dir/appimagetool-x86_64.AppImage"
  curl -fsSL -o "$image" "$url"
  chmod +x "$image"
  rm -rf "$dir/squashfs-root"
  (cd "$dir" && "$image" --appimage-extract >/dev/null)
  if [ ! -x "$apprun" ]; then
    err "could not extract appimagetool"
    return 1
  fi
  printf '%s' "$apprun"
}

# Wraps the jpackage app image the Compose plugin produces (built by the
# createDistributable task) in an AppDir and packs it into a single-file
# AppImage at $1. The app image already carries its own runtime, so the result
# needs no Java on the target machine.
build_desktop_appimage() {
  local out="$1"
  local app_dir="desktopApp/build/compose/binaries/main/app/BTC Map"
  if [ ! -x "$app_dir/bin/BTC Map" ]; then
    err "desktop app image not found at $app_dir; run :desktopApp:createDistributable first."
    return 1
  fi

  local out_dir appdir
  out_dir="$(dirname "$out")"
  appdir="$out_dir/BTC-Map.AppDir"
  rm -rf "$out_dir"
  mkdir -p "$appdir/usr"
  cp -a "$app_dir/." "$appdir/usr/"

  # The jpackage launcher has a space in its name; an alias without one is
  # friendlier for the desktop entry (Exec=/Icon=) and for a PATH install.
  cat > "$appdir/usr/bin/btc-map" <<'RUN'
#!/bin/sh
HERE="$(dirname "$(readlink -f "$0")")"
exec "$HERE/BTC Map" "$@"
RUN
  chmod +x "$appdir/usr/bin/btc-map"

  cat > "$appdir/AppRun" <<'RUN'
#!/bin/sh
HERE="$(dirname "$(readlink -f "$0")")"
exec "$HERE/usr/bin/btc-map" "$@"
RUN
  chmod +x "$appdir/AppRun"

  cat > "$appdir/btc-map.desktop" <<'DESKTOP'
[Desktop Entry]
Type=Application
Name=BTC Map
Comment=Map of Bitcoin merchants
Exec=btc-map
Icon=btc-map
Categories=Finance;Network;
Terminal=false
DESKTOP

  cp fastlane/metadata/android/en-US/images/icon.png "$appdir/btc-map.png"

  local appimagetool
  appimagetool="$(prepare_appimagetool)"

  echo "Packing $out..."
  ARCH=x86_64 "$appimagetool" "$appdir" "$out"
}

# END appimage section

# START conveyor section

# Every desktop artifact lives under one directory on the CDN, one per channel:
# the Windows and macOS packages Conveyor builds and the Linux AppImage.
desktop_cdn_base="https://cdn.static.btcmap.org/desktop"
desktop_dest="btcmap-api:/srv/http/static.btcmap.org/desktop"

# Conveyor builds the Windows (MSIX, plus an installer .exe and a portable .zip)
# and macOS (a signed, Sparkle-updating .app archive) packages from this Linux
# machine. That is the whole reason it is here: jpackage, which the Compose
# plugin wraps, cannot cross-compile and silently skips the foreign-OS formats,
# so without Conveyor the desktop app could only ever ship as a Linux AppImage.
#
# It is a ~111 MB tool, cached under ${XDG_CACHE_HOME}/btcmap/conveyor on first
# use. Point CONVEYOR at a binary to use an install of your own instead, or
# CONVEYOR_URL at a different download.
conveyor_version_default="22.3"
conveyor_url_default="https://downloads.hydraulic.dev/conveyor/conveyor-${conveyor_version_default}-linux-amd64.tar.gz"

# Downloads and unpacks Conveyor into a cache on first use, then prints the path
# to its launcher.
prepare_conveyor() {
  if [ -n "${CONVEYOR:-}" ]; then
    printf '%s' "$CONVEYOR"
    return 0
  fi

  local dir="${XDG_CACHE_HOME:-$HOME/.cache}/btcmap/conveyor"
  local bin="$dir/conveyor-${conveyor_version_default}/bin/conveyor"
  if [ -x "$bin" ]; then
    printf '%s' "$bin"
    return 0
  fi

  local url="${CONVEYOR_URL:-$conveyor_url_default}"
  echo "Downloading Conveyor from $url..." >&2
  mkdir -p "$dir"
  local tarball="$dir/conveyor.tar.gz"
  curl -fsSL -o "$tarball" "$url"
  tar xzf "$tarball" -C "$dir"
  rm -f "$tarball"
  if [ ! -x "$bin" ]; then
    err "could not unpack Conveyor"
    return 1
  fi
  printf '%s' "$bin"
}

# The Conveyor signing root key: the one key every Windows and macOS package
# key, update feed and package identity is derived from. It is signing material,
# so it is kept beside the Android keystore and outside the repository, and
# local.properties points at it, exactly as it points at the keystore itself.
# Losing or rotating it breaks updates for every copy already installed and
# looks like a different app to Windows, so it is never created anywhere else.
conveyor_signing_key() {
  sed -n 's/^conveyor\.signing\.key=//p' local.properties 2>/dev/null | head -n1
}

# Uses the root key at the configured path, generating it there on first use. If
# it has a passphrase (conveyor keys passphrase), export it as
# CONVEYOR_PASSPHRASE so the builds can unlock it.
ensure_conveyor_key() {
  local conveyor="$1"
  local key
  key="$(conveyor_signing_key)"
  if [ -z "$key" ]; then
    err "no 'conveyor.signing.key' in local.properties; refusing to deploy."
    err "It must point at the Conveyor signing root key file, which belongs beside the Android keystore, outside the repository."
    return 1
  fi
  if [ "$(basename "$key")" != "defaults.conf" ]; then
    err "conveyor.signing.key must name the file defaults.conf, the name Conveyor writes the root key to (got $(basename "$key"))."
    return 1
  fi
  if [ -f "$key" ]; then
    return 0
  fi

  echo "Generating the Conveyor signing root key (once) at $key..." >&2
  mkdir -p "$(dirname "$key")"
  "$conveyor" --agree-to-license=1 keys generate --no-passphrase -o "$(dirname "$key")"
  cat >&2 <<EOF

Back this file up now: $key
Every Windows and macOS package key, update feed and package identity comes from
it. Without it, every copy already installed can never be updated again.
EOF
}

# Builds the Windows and macOS packages and their update site into $3 for the
# channel in $2 (beta or release), using the Conveyor in $1. The channel is the
# last path segment of the update URL baked into the packages, so installed
# copies check only their own channel; changing it later strands the copies
# already out there.
build_desktop_packages() {
  local conveyor="$1"
  local channel="$2"
  local out="$3"

  rm -rf "$out"

  # A debuggable build when asked for: the same packages, but with the JVM
  # attach mechanism re-enabled (a signed launcher disables it, which is why a
  # running Windows build cannot be inspected), a console, and a JDWP port. See
  # conveyor-debug.conf. Traffic and the published channel are unchanged.
  local conf="desktopApp/conveyor.conf"
  if [ -n "${CONVEYOR_DEBUG:-}" ]; then
    conf="desktopApp/conveyor-debug.conf"
    echo "Building a DEBUG build of the desktop packages (attach enabled, console, JDWP on 127.0.0.1:5005)." >&2
  fi

  local args=("--agree-to-license=1")
  # Conveyor will not prompt for a passphrase without a terminal, so an
  # encrypted root key has to be unlocked through the environment.
  if [ -n "${CONVEYOR_PASSPHRASE:-}" ]; then
    args+=("--passphrase=env:CONVEYOR_PASSPHRASE")
  fi
  args+=("-f" "$conf" "-Kapp.site.base-url=$desktop_cdn_base/$channel")

  echo "Building the Windows and macOS packages for the $channel channel..."
  "$conveyor" "${args[@]}" make site --output-dir "$out"
}

# Purges every file the packaged site contains from the CDN. The names embed the
# version and are stable only across a rebuild of the same version, so they are
# read from the output directory rather than listed by hand.
purge_conveyor_site() {
  local channel="$1"
  local dir="$2"
  local urls=()
  local file
  while IFS= read -r file; do
    urls+=("$desktop_cdn_base/$channel/${file#"$dir"/}")
  done < <(find "$dir" -type f | sort)
  purge_cdn "${urls[@]}"
}

# END conveyor section

# START app section

cmd_app_install() {
  local device="emulator-5554"
  local apk_path="./app/build/outputs/apk/debug/app-x86_64-debug.apk"

  if ! adb devices | grep -q "^$device[[:space:]]"; then
    echo "Error: emulator $device is not running. Start it with: ./devtools emulator start" >&2
    return 1
  fi

  echo "Assembling debug APK..."
  ./gradlew assembleDebug "$@"

  if [ ! -f "$apk_path" ]; then
    echo "Error: APK not found at $apk_path" >&2
    return 1
  fi

  echo "Installing $apk_path on $device..."
  adb -s "$device" install -r -t "$apk_path"
}

cmd_app_run_android() {
  local device="emulator-5554"
  local package="org.btcmap.debug"
  local apk_path="./app/build/outputs/apk/debug/app-x86_64-debug.apk"

  if ! adb devices | grep -q "^$device[[:space:]]"; then
    echo "Error: emulator $device is not running. Start it with: ./devtools emulator start" >&2
    return 1
  fi

  echo "Assembling debug APK..."
  ./gradlew assembleDebug "$@"

  if [ ! -f "$apk_path" ]; then
    echo "Error: APK not found at $apk_path" >&2
    return 1
  fi

  echo "Installing $apk_path on $device..."
  adb -s "$device" install -r -t "$apk_path"

  echo "Launching $package..."
  adb -s "$device" shell monkey -p "$package" -c android.intent.category.LAUNCHER 1

  echo "Process status:"
  adb -s "$device" shell ps -A | grep btcmap || echo "(process not visible yet — give it a moment)"
}

cmd_app_run_desktop() {
  local log="/tmp/btcmap-desktop.log"

  # Two instances would open the same database under $BTCMAP_HOME, so refuse to
  # start a second one.
  if pgrep -f "org.btcmap.desktop.MainK[t]" >/dev/null 2>&1; then
    echo "The desktop app is already running; not starting a second instance."
    echo "Stop it with: ./devtools app stop"
    return 0
  fi

  echo "Launching the desktop app (logs: $log)..."
  # Detached: `run` blocks for the life of the window, so control returns here.
  (./gradlew :desktopApp:run "$@" > "$log" 2>&1 &)
}

cmd_app_stop_desktop() {
  if ! pgrep -f "org.btcmap.desktop.MainK[t]" >/dev/null 2>&1; then
    echo "The desktop app is not running. Nothing to do."
    return 0
  fi

  echo "Stopping the desktop app..."
  pgrep -f "org.btcmap.desktop.MainK[t]" | xargs -r kill
}

cmd_app_stop_android() {
  local device="emulator-5554"
  local package="org.btcmap.debug"

  if ! adb devices | grep -q "^$device[[:space:]]"; then
    echo "Error: emulator $device is not running. Start it with: ./devtools emulator start" >&2
    return 1
  fi

  echo "Stopping $package on $device..."
  adb -s "$device" shell am force-stop "$package"
}

# Chooses the app target from optional --android/--desktop flags (desktop by
# default), leaving the remaining arguments (forwarded to Gradle) in
# app_target_args. Prints the app usage and returns 1 when asked for help.
app_target="desktop"
app_target_args=()

parse_app_target() {
  app_target="desktop"
  app_target_args=()
  local arg
  for arg in "$@"; do
    case "$arg" in
      --android) app_target="android" ;;
      --desktop) app_target="desktop" ;;
      help|-h|--help) print_usage_app; return 1 ;;
      *) app_target_args+=("$arg") ;;
    esac
  done
}

cmd_app_run() {
  parse_app_target "$@" || return 0
  case "$app_target" in
    android) cmd_app_run_android "${app_target_args[@]}" ;;
    desktop) cmd_app_run_desktop "${app_target_args[@]}" ;;
  esac
}

cmd_app_stop() {
  parse_app_target "$@" || return 0
  case "$app_target" in
    android) cmd_app_stop_android ;;
    desktop) cmd_app_stop_desktop ;;
  esac
}

cmd_app_uninstall() {
  local device="emulator-5554"
  local package="org.btcmap.debug"

  if ! adb devices | grep -q "^$device[[:space:]]"; then
    echo "Error: emulator $device is not running. Start it with: ./devtools emulator start" >&2
    return 1
  fi

  if ! adb -s "$device" shell pm list packages "$package" 2>/dev/null \
      | tr -d '\r' | grep -qx "package:$package"; then
    echo "$package is not installed on $device. Nothing to do."
    return 0
  fi

  echo "Uninstalling $package from $device..."
  local result
  if result=$(adb -s "$device" uninstall "$package" 2>&1); then
    echo "$result"
  else
    echo "Uninstall failed: $result" >&2
    return 1
  fi
}

cmd_app_deploy_beta() {
  assert_bunny_api_key

  # Resolve the signing key before Gradle runs: the generated Conveyor config
  # includes it, so it has to exist by the time writeConveyorConfig writes that.
  local conveyor
  conveyor="$(prepare_conveyor)"
  ensure_conveyor_key "$conveyor"

  # The APKs need the beta build type; the desktop app is a single build every
  # channel shares, so its packages come from the ordinary jar. The generated
  # Conveyor config has to be written before Conveyor reads it.
  ./gradlew assembleBeta :desktopApp:createDistributable \
    :shared:jvmJar :ui:jvmJar :desktopApp:jar :desktopApp:writeConveyorConfig "$@"

  local apk_dir="app/build/outputs/apk/beta"
  local dest="btcmap-api:/srv/http/static.btcmap.org/android/apk/"
  local manifest_dest="btcmap-api:/srv/http/static.btcmap.org/android/latest-app-beta-ver.json"
  local appimage_out="desktopApp/build/compose/appimage/BTC-Map-x86_64.AppImage"
  local packages_out="desktopApp/build/conveyor/beta"
  local beta_dest="$desktop_dest/beta/"
  local build_config="app/build/generated/source/buildConfig/beta/org/btcmap/BuildConfig.java"

  assert_apk_signed "$apk_dir/app-arm64-v8a-beta.apk"
  assert_apk_signed "$apk_dir/app-universal-beta.apk"

  build_desktop_appimage "$appimage_out"
  build_desktop_packages "$conveyor" beta "$packages_out"

  local version_code version_name
  version_code="$(sed -n 's/.*VERSION_CODE = \([0-9]*\);.*/\1/p' "$build_config" | head -n1)"
  version_name="$(sed -n 's/.*VERSION_NAME = "\(.*\)";.*/\1/p' "$build_config" | head -n1)"
  if [ -z "$version_code" ] || [ -z "$version_name" ]; then
    echo "Error: could not read version info from $build_config" >&2
    return 1
  fi

  local manifest
  manifest="$(mktemp)"
  cat > "$manifest" <<JSON
{
  "code": $version_code,
  "name": "$version_name",
  "url": "https://cdn.static.btcmap.org/android/apk/beta.apk"
}
JSON
  chmod 644 "$manifest"

  rsync -avz --progress "$apk_dir"/app-arm64-v8a-beta.apk "$dest/beta.apk"
  rsync -avz --progress "$apk_dir"/app-universal-beta.apk "$dest/beta-universal.apk"
  # No --delete on the site: Conveyor keeps each version's package online so it
  # can generate deltas from it for the next one, so the older files are meant to
  # stay. Its own versioned file names never collide.
  rsync -avz --progress --mkpath --chmod=D755,F644 "$packages_out"/ "$beta_dest"
  rsync -avz --progress --mkpath --chmod=F755 "$appimage_out" "$beta_dest/BTC-Map-x86_64.AppImage"
  rsync -avz --progress --chmod=F644 "$manifest" "$manifest_dest"
  rm -f "$manifest"

  # The APK, the AppImage and the manifest are overwritten in place, as is the
  # part of the site whose names do not carry a version (the update metadata,
  # the download page, the installer and the update checker), so the pull zone
  # would keep serving its cached copy for the full max-age window unless we
  # purge it.
  purge_cdn \
    "https://cdn.static.btcmap.org/android/apk/beta.apk" \
    "https://cdn.static.btcmap.org/android/apk/beta-universal.apk" \
    "$desktop_cdn_base/beta/BTC-Map-x86_64.AppImage" \
    "https://cdn.static.btcmap.org/android/latest-app-beta-ver.json"
  purge_conveyor_site beta "$packages_out"
}

cmd_app_deploy_release() {
  assert_bunny_api_key

  # Resolve the signing key before Gradle runs: the generated Conveyor config
  # includes it, so it has to exist by the time writeConveyorConfig writes that.
  local conveyor
  conveyor="$(prepare_conveyor)"
  ensure_conveyor_key "$conveyor"

  ./gradlew assembleRelease :desktopApp:createDistributable \
    :shared:jvmJar :ui:jvmJar :desktopApp:jar :desktopApp:writeConveyorConfig "$@"

  local apk_dir="app/build/outputs/apk/release"
  local dest="btcmap-api:/srv/http/static.btcmap.org/android/apk/"
  local packages_out="desktopApp/build/conveyor/release"
  local release_dest="$desktop_dest/release/"
  local build_config="app/build/generated/source/buildConfig/release/org/btcmap/BuildConfig.java"

  assert_apk_signed "$apk_dir/app-arm64-v8a-release.apk"
  assert_apk_signed "$apk_dir/app-universal-release.apk"

  local version_name
  version_name="$(sed -n 's/.*VERSION_NAME = "\(.*\)";.*/\1/p' "$build_config" | head -n1)"
  if [ -z "$version_name" ]; then
    echo "Error: could not read version info from $build_config" >&2
    return 1
  fi

  local apk_base="btcmap-android-${version_name}"
  # The release AppImage is named after the version, like the APKs, so each
  # release can be told apart; the beta one keeps a stable name instead.
  local appimage_out="desktopApp/build/compose/appimage/BTC-Map-${version_name}-x86_64.AppImage"

  build_desktop_appimage "$appimage_out"
  build_desktop_packages "$conveyor" release "$packages_out"

  rsync -avz --progress "$apk_dir"/app-arm64-v8a-release.apk "$dest/${apk_base}.apk"
  rsync -avz --progress "$apk_dir"/app-universal-release.apk "$dest/${apk_base}-universal.apk"
  rsync -avz --progress --mkpath --chmod=D755,F644 "$packages_out"/ "$release_dest"
  rsync -avz --progress --mkpath --chmod=F755 "$appimage_out" "$release_dest"

  # A rebuilt APK, AppImage or site can be published under a name that is
  # already on the CDN (for example when re-releasing a fix for the same
  # version), so the pull zone would keep serving the previous bytes for the
  # full max-age window unless we purge it.
  purge_cdn \
    "https://cdn.static.btcmap.org/android/apk/${apk_base}.apk" \
    "https://cdn.static.btcmap.org/android/apk/${apk_base}-universal.apk" \
    "$desktop_cdn_base/release/$(basename "$appimage_out")"
  purge_conveyor_site release "$packages_out"
}

cmd_app() {
  local target="${1:-help}"
  shift || true
  case "$target" in
    install) cmd_app_install "$@" ;;
    run) cmd_app_run "$@" ;;
    stop) cmd_app_stop "$@" ;;
    uninstall) cmd_app_uninstall "$@" ;;
    deploy-beta) cmd_app_deploy_beta "$@" ;;
    deploy-release) cmd_app_deploy_release "$@" ;;
    help|-h|--help) print_usage_app ;;
    *) err "Unknown app command: $target"; print_usage_app; return 1 ;;
  esac
}

# END app section

main() {
  local cmd="${1:-help}"
  shift || true
  case "$cmd" in
    emulator) cmd_emulator "$@" ;;
    app) cmd_app "$@" ;;
    bundle) cmd_bundle "$@" ;;
    website) cmd_website "$@" ;;
    help|-h|--help) print_usage ;;
    *) err "Unknown command: $cmd"; print_usage; return 1 ;;
  esac
}

main "$@"
