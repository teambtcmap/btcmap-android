# IDE project files, because
# the project can be imported from settings.gradle
*.iml
.idea
.project
.classpath
.settings/

# Local configuration file (sdk path, etc)
local.properties

# Release signing configuration file
signing.properties

# Waydroid session output, from ./devtools app run --android
/waydroid.log

# Build output directory
build/

# Release binaries staged by ./devtools app prepare-release
/release/

# Gradle cache
.gradle

# Kotlin build session files
.kotlin/

# Signed APK dirs
app/fdroid
app/play

# Conveyor's generated config and its packaged output. The config holds absolute
# paths to this machine's Gradle cache and is regenerated by the deploy
# commands; the packages are uploaded, not committed.
desktopApp/generated.conveyor.conf
desktopApp/build/conveyor/

# Python bytecode cache
__pycache__/

# Hugo documentation site build output
website/public/
website/resources/
website/.hugo_build.lock

# opencode
.opencode
